\begin{tikzpicture}
\coordinate (A) at (0,0);
\coordinate (B) at (4,0);
\coordinate (C) at (5,3);
\coordinate (D) at (1,3);
\coordinate (M) at ($(A)!0.5!(B)$);
\coordinate (N) at ($(B)!0.5!(C)$);
\coordinate (P) at ($(C)!0.5!(D)$);
\coordinate (Q) at ($(D)!0.5!(A)$);
\draw (A) -- (B) -- (C) -- (D) -- cycle;
\draw[red] (M) -- (N) -- (P) -- (Q) -- cycle;
\end{tikzpicture}
