\begin{tikzpicture}
\coordinate (A) at (0,0);
\coordinate (B) at (4,0);
\coordinate (C) at (0,3);
\path let \p1=($(B)-(C)$), \p2=($(A)-(C)$), \p3=($(A)-(B)$),
  \n1={veclen(\x1,\y1)}, \n2={veclen(\x2,\y2)}, \n3={veclen(\x3,\y3)}
  in coordinate (I) at ($({(\n1*0+\n2*4+\n3*0)/(\n1+\n2+\n3)},{(\n1*0+\n2*0+\n3*3)/(\n1+\n2+\n3)})$);
\draw (A) -- (B) -- (C) -- cycle;
\end{tikzpicture}
