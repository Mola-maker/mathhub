\begin{tikzpicture}
\coordinate (A) at (0,0);
\coordinate (B) at (4,0);
\coordinate (C) at (1,3);
\coordinate (F1) at ($(A)!(C)!(B)$);
\coordinate (F2) at ($(B)!(A)!(C)$);
\path[name path=h1] (C) -- (F1);
\path[name path=h2] (A) -- (F2);
\path[name intersections={of=h1 and h2}] (intersection-1) coordinate (H);
\draw (A) -- (B) -- (C) -- cycle;
\end{tikzpicture}
