{
  "name": "molamaker-math-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "mathhub"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:tikz": "node tools/dev-tikz-studio.mjs",
    "dev:compiler:native": "node services/tikz-compiler/local-dev-server.mjs",
    "dev:mathhub": "npm run dev --workspace mathhub",
    "build:mathhub": "npm run build --workspace mathhub",
    "build": "npm run build:mathhub && next build",
    "build:sites": "vinext build",
    "start": "next start",
    "generate:tikz-parser": "lezer-generator --typeScript --output lib/tikz/editor/tikz-parser.ts lib/tikz/editor/tikz.grammar",
    "generate:tikz-registry": "node tools/generate-pgf-registry.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --maxWorkers=2",
    "test:compiler": "node --test services/tikz-compiler/*.test.mjs",
    "audit:cdn": "node tools/audit-static-assets.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "katex": "^0.17.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "redis": "^6.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@lezer/generator": "^1.8.0",
    "@next/eslint-plugin-next": "^16.2.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-rsc": "^0.5.26",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "react-server-dom-webpack": "^19.2.7",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vinext": "^0.0.50",
    "vite": "^8.0.13",
    "vitest": "^4.1.7",
    "wrangler": "^4.92.0"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "overrides": {
    "ws": "^8.21.0"
  },
  "type": "module"
}
