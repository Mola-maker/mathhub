# All upstream requests are hard-locked to https://api.molamaker.cn.
# Configure only your own API key here. Keep it server-side; never use NEXT_PUBLIC_.
LLM_RELAY_API_KEY=
LLM_RELAY_MODEL=
# Required for read-only Canvas visual audits. Keep this separate from the
# drawing/reasoning model because many chat models cannot decode images.
LLM_RELAY_VISION_MODEL=

# Optional local Vite origin. When set, Next keeps http://localhost:3000 as the
# only browser-facing address and proxies / + /mathhub/* to the MathHub dev app.
# Production leaves this empty and serves the build from /public/mathhub.
MATHHUB_DEV_ORIGIN=http://127.0.0.1:5173

# Shared Tair/Redis fixed-window limiter. Required in production so all ECS
# web replicas enforce one quota. It may reuse REDIS_URL with a separate prefix.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_PREFIX=math-geohub:rate

# Shared append-only Agent run checkpoints. Production may reuse the same
# Redis endpoint with a separate prefix. Required in production so a proposal
# can be verified after a web-instance change and terminal events use CAS.
AGENT_RUN_REDIS_URL=
AGENT_RUN_REDIS_PREFIX=math-geohub:agent-run
AGENT_RUN_RESUME_SECRET=
# HMAC key for short-lived, read-only geometry problem inspection receipts.
# Required in production; use at least 32 random bytes and never expose it.
PROBLEM_INSPECTION_SECRET=

# Local compiler service. Use an ECS internal URL in production.
TIKZ_COMPILER_URL=http://127.0.0.1:8787
TIKZ_COMPILER_TOKEN=replace-with-a-long-random-secret
# Lua-backed graph drawing is a distinct exact-runtime profile. Leave these
# empty until the companion API/Worker image has passed its own warmup gates;
# graphdrawing source will then fail explicitly instead of hitting Tectonic.
TIKZ_GRAPHDRAWING_COMPILER_URL=
TIKZ_GRAPHDRAWING_COMPILER_TOKEN=
# Production Compose uses this same immutable reference for both image:
# selection and the compiler provenance/cache namespace.
COMPILER_WORKER_IMAGE_REF=registry.example/math-geohub-tikz-worker@sha256:replace-with-64-hex-digest
GRAPHDRAWING_COMPILER_WORKER_IMAGE_REF=registry.example/math-geohub-tikz-graphdrawing-worker@sha256:replace-with-64-hex-digest

# Optional GeoGebra CDN/self-host origin exposed to the browser.
NEXT_PUBLIC_GEOGEBRA_BASE_URL=

# Geometry problem gateways. MathNet uses its public Hugging Face dataset and
# needs no secret. Optional sources stay disabled until an approved mirror and
# the matching license policy are configured explicitly.
OLYMPIADBENCH_DATA_URL=
FORMALGEO_DATA_URL=
FORMALGEO_ACCEPT_RESTRICTED_LICENSE=0
